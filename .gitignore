# --- Secrets (RULE-6: no credentials or tokens in the repo) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# --- Local runtime data (RULE-6: never commit uploaded files or a live DB) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/uploads/*
!data/uploads/.gitkeep
storage/

# --- Observability (optional Phoenix dev microscope) ---
.phoenix/
phoenix.db

# --- Working notes, kept local ---
# Session handover, the phase checklist, and the organizer's brief. None of
# these is a submission deliverable; the shipped documentation is README.md,
# CLAUDE.md and docs/prd-agentcare.md.
HANDOFF.md
PLAN.md
problem_statement_hackathon_details.md

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
