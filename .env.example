# AgentCare — environment configuration template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must NEVER be committed (hackathon RULE-6).
# Every value below is a placeholder — no real credentials live in this file.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider the whole application runs on: mock | openai | groq
# All three are first-class: the app works end to end under any of them.
#   mock   - deterministic understudy, no API key, no network. Used by tests
#            and offline demos. Emits real tool calls and real DB writes;
#            replies are templated from persisted tool results.
#   groq   - default for live runs (fast + generous free tier)
#   openai - alternative live provider
LLM_PROVIDER=groq

# Per-provider keys. Only the key for the selected provider is required.
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk-your_openai_key_here

# Per-provider model names — deliberately separate variables, never one shared
# LLM_MODEL, so switching providers can't silently send a Groq model id to OpenAI.
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Application database. SQLite file by default — a real file on disk, never
# :memory: (RULE-4: state must survive a restart).
# Postgres (day-4 deploy):  postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/agentcare.db

# ADK session store. Separate from DATABASE_URL and NOT interchangeable with it:
# DatabaseSessionService requires the async driver (sqlite+aiosqlite://).
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_me_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Frontend -> backend
# ---------------------------------------------------------------------------
# Where the Streamlit client reaches FastAPI. Change when the two are deployed
# to different hosts (that split also requires CORS_ORIGINS below).
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501

# ---------------------------------------------------------------------------
# Time
# ---------------------------------------------------------------------------
# The live app always uses the real current date. APP_TODAY overrides
# clock.today() with a frozen YYYY-MM-DD for golden tests and reproducible
# demos ONLY. Leave blank in normal operation.
APP_TODAY=

# ---------------------------------------------------------------------------
# Agent limits (boundedness invariant — every automated writer has a cap)
# ---------------------------------------------------------------------------
MAX_TOOL_ITERATIONS=8
MAX_REPLANS_PER_RUN=1
MAX_CONFIRMATION_NON_ANSWERS=3
MAX_REMINDER_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Uploads (hardening: the client-supplied filename is a path-traversal vector)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_MIME=application/pdf,image/png,image/jpeg

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# How often the poll job scans for due reminders and sweeps past-dated
# confirmed appointments to completed.
REMINDER_POLL_SECONDS=60
# How many due reminders one tick will take. A bound on the tick, not on the
# work: whatever is left is still due next time.
REMINDER_BATCH_SIZE=50
# Whether the background poll thread runs at all. The test suite sets this to
# false and drives the tick directly — a thread ticking underneath a test would
# be a source of writes nobody asked for.
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional Arize Phoenix dev microscope (extra install; off by default).
PHOENIX_ENABLED=false
